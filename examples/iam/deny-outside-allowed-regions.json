{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyAllOutsideSydneyAndUsEast1",
      "Effect": "Deny",
      "NotAction": [
        "iam:*",
        "sts:*",
        "organizations:*",
        "cloudfront:*",
        "route53:*",
        "support:*",
        "budgets:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": ["ap-southeast-2", "us-east-1"]
        }
      }
    }
  ]
}
